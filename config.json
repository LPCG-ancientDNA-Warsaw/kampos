{
  "database": {
    "db_name": "lpcgdb01",
    "host": "localhost",
    "port": "5432",
    "type": "postgresql",
    
    "projects": [
      {
        "name": "human",
        "schema_name": "lab_data",
        "backups_path": "",

        "mapping": {
          "individual_id" : {
            "column_name" : "lab_id",
            "base_table" : "individuals"
          },
          "site_name" : {
            "column_name" : "site_name",
            "base_table" : "sampling_sites"
          },
          "epoch": {
            "column_name" : "epoch",
            "base_table" : "individuals"
          },
          "time_period": {
            "column_name" : "time_period",
            "base_table" : "individuals"
          },
          "grave_no": {
            "column_name" : "grave_no",
            "base_table" : "individuals"
          },
          "contact_person": {
            "column_name" : "contact_person",
            "base_table" : "individuals"
          },
          "material_id" : {
            "column_name" : "material_id",
            "base_table" : "processed_samples"
          },
          "material_description" : {
            "column_name" : "material_description",
            "base_table" : "processed_samples"
          },
          "prep_date" : {
            "column_name" : "prep_date",
            "base_table" : "processed_samples"
          },
          "prep_operator" : {
            "column_name" : "prep_operator",
            "base_table" : "processed_samples"
          },
          "extract_date" : {
            "column_name" : "extract_date",
            "base_table" : "dna_extractions"
          },
          "extract_operator" : {
            "column_name" : "extract_operator",
            "base_table" : "dna_extractions"
          },
          "extract_method" : {
            "column_name" : "extract_method",
            "base_table" : "dna_extractions"
          },
          "library_id" : {
            "column_name" : "library_id",
            "base_table" : "libraries"
          },
          "library_type" : {
            "column_name" : "library_type",
            "base_table" : "libraries"
          },
          "library_operator" : {
            "column_name" : "library_operator",
            "base_table" : "libraries"
          },
          "raw_reads" : {
            "column_name" : "raw_reads",
            "base_table" : "dna_sequencing"
          },
          "endo_dna" : {
            "column_name" : "endo_dna",
            "base_table" : "dna_mapping"
          },
          "tot_reads_map" : {
            "column_name" : "tot_reads_map",
            "base_table" : "dna_mapping"
          },
          "coord_ns": {
            "column_name" : "coord_ns",
            "base_table" : "individuals"
          },
          "coord_we": {
            "column_name" : "coord_we",
            "base_table" : "individuals"
          },
          "project_id": {
            "column_name" : "project_id",
            "base_table" : "individuals"
          },
          "fastq_name": {
            "column_name" : "fastq_name",
            "base_table" : "dna_sequencing"
          }
        },

        "summaries_fields" : {
          "individual" : ["site_name",
            "material_id",
            "prep_date",
            "extract_date",
            "library_id",
            "raw_reads",
            "endo_dna",
            "tot_reads_map"]
        },

        "table_hierarchies": {
          "individuals": {
            "parent": "sampling_sites",
            "join_on": "site_name"
          },
          "indexing": {
            "parent": "sequencing_runs",
            "join_on": "sequencing_id"
          }
        },

        "default_values": {
          "country": "Poland",
          "extract_method": "Rohland et al. 2018",
          "lysis_method": "Rohland et al. 2018",
          "library_type": "Single",
          "index_method": "Cx, XX ul",
          "qPCR_method": "AA Biotech",
          "shotgun_enriched": "No",
          "merged": "FALSE"
        },

        "users": {
          "fleotta": {
            "regex": "^([A-Z]{2}\\d{3})([A-Z]\\d+)([A-Z]\\d+)([a-z]+)_(.*)_(.*)$",
            "groups": ["lab_id", "material_ext", "lib_seq_type", "udg", "enrichment", "seq_run_id"]
          },
          "prof_x": {
            "regex": "^ID_(\\d+)_.*",
            "groups": ["lab_id"]
          }
        }
      }
    ]

  }
}